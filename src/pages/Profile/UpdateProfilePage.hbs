<div class="page-wrapper">
    <div class="profile-layout">
        {{> BackLink href="#" data-page='profile' }}

        <main class="profile">
            <div class="profile__header">
                <div class="profile__avatar">
                    {{> ProfileAvatar url="/src/assets/images/profile-avatar-stub.svg"}}
                </div>
            </div>

            <ul class="profile__list">
                <li class="profile__item">
                    <span class="profile__key">Почта</span>
                    <span class="profile__value">
                        {{> Input id="email" type="text" placeholder="Введите E-mail" value=email }}
                    </span>
                </li>

                <li class="profile__item">
                    <span class="profile__key">Логин</span>
                    <span class="profile__value">
                        {{> Input id="login" type="text" placeholder="Введите логин" value=login }}
                    </span>
                </li>

                <li class="profile__item">
                    <span class="profile__key">Имя</span>
                    <span class="profile__value">
                        {{> Input id="first_name" type="text" placeholder="Введите имя" value=first_name }}
                    </span>
                </li>

                <li class="profile__item">
                    <span class="profile__key">Фамилия</span>
                    <span class="profile__value">
                        {{> Input id="second_name" type="text" placeholder="Введите фамилию" value=second_name }}
                    </span>
                </li>

                <li class="profile__item">
                    <span class="profile__key">Имя в чате</span>
                    <span class="profile__value">
                        {{> Input id="display_name" type="text" placeholder="Введите отображаемое имя" value=display_name }}
                    </span>
                </li>

                <li class="profile__item">
                    <span class="profile__key">Телефон</span>
                    <span class="profile__value">
                        {{> Input id="phone" type="text" placeholder="Введите телефон" value=phone }}
                    </span>
                </li>
            </ul>

            <div class="profile__actions">
                {{> Button text="Сохранить"}}
            </div>
        </main>

        {{> Footer}}
    </div>
</div>
