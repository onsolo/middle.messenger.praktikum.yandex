<div class="page-wrapper">
    <div class="profile-layout">
        {{> BackLink href="#" data-page='profile' }}

        <main class="profile">
            <div class="profile__header">
                <div class="profile__avatar">
                    {{> ProfileAvatar url=avatar_url}}
                </div>
            </div>

            <ul class="profile__list">
                <li class="profile__item">
                    <span class="profile__key">Старый пароль</span>
                    <span class="profile__value">
                        {{> Input id="oldPassword" type="password" placeholder="" }}
                    </span>
                </li>

                <li class="profile__item">
                    <span class="profile__key">Новый пароль</span>
                    <span class="profile__value">
                        {{> Input id="newPassword" type="password" placeholder="" }}
                    </span>
                </li>

                <li class="profile__item">
                    <span class="profile__key">Повторите новый пароль</span>
                    <span class="profile__value">
                        {{> Input id="repeatPassword" type="password" placeholder="" }}
                    </span>
                </li>
            </ul>

            <div class="profile__actions">
                {{> Button text="Сохранить"}}
            </div>
        </main>

        {{> Footer}}
    </div>
</div>
