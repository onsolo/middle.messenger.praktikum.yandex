<div class="page-wrapper">
    <main class="auth-layout">
        <div class="auth-card">
            <h1 class="auth-card__title">
                Регистрация
            </h1>
            <form class="auth-card__form">
                {{> Input id="email" type="text" placeholder="Почта" is-bordered="true" }}
                {{> Input id="login" type="text" placeholder="Логин" is-bordered="true" }}
                {{> Input id="first_name" type="text" placeholder="Имя" is-bordered="true" }}
                {{> Input id="second_name" type="text" placeholder="Фамилия" is-bordered="true" }}
                {{> Input id="phone" type="text" placeholder="Телефон" is-bordered="true" }}
                {{> Input id="password" type="password" placeholder="Пароль" is-bordered="true" }}
                {{> Input id="repeat-password" type="password" placeholder="Пароль (ещё раз)" is-bordered="true" }}
            </form>
            <div class="auth-card__actions">
                {{> Button id="submitRegister" text="Зарегистрироваться" }}
                {{> Link href="#" data-page="login" text="Войти" is-active="true" }}
            </div>
        </div>
    </main>

    {{> Footer}}
</div>
