<div class="page-wrapper">
    <main class="auth-layout">
        <div class="auth-card">
            <h1 class="auth-card__title">
                Вход
            </h1>
            <form class="auth-card__form">
                {{> Input id="login" type="text" placeholder="Логин" is-bordered="true" }}
                {{> Input id="password" type="password" placeholder="Пароль" is-bordered="true" }}
            </form>
            <div class="auth-card__actions">
                {{> Button id="submitLogin" text="Войти" }}
                {{> Link href="#" data-page="register" text="Нет аккаута?" is-active="true" }}
            </div>
        </div>

    </main>
    {{> Footer}}
</div>

